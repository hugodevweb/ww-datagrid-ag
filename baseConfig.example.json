{
  "_comment": "Bind this object to the 'Base Config' property on each grid instance. Remove keys you don't want standardized. Use 'Base Config Excludes' on a specific grid to opt out of individual keys.",

  "layout": "fixed",
  "height": "500px",

  "pagination": true,
  "paginationPageSize": 25,
  "hasPaginationSelector": "multiple",
  "paginationPageSizeSelector": [10, 25, 50, 100],

  "rowSelection": "multiple",
  "enableClickSelection": false,
  "disableCheckboxes": false,
  "selectAll": "filtered",

  "resizableColumns": true,
  "movableColumns": true,
  "columnHoverHighlight": false,
  "allowColumnHiding": true,
  "rowReorder": false,

  "cellEditMode": "doubleClick",
  "cellAlignmentMode": "default",
  "invalidEditValueMode": "revert",

  "rowBuffer": 10,
  "suppressAnimationFrame": false,

  "textColor": "#111827",
  "borderColor": "#E5E7EB",
  "outerBorderColor": "#E5E7EB",
  "wrapperBorderRadius": "8px",

  "headerBackgroundColor": "#F9FAFB",
  "headerTextColor": "#374151",
  "headerFontSize": "13px",
  "headerFontFamily": "Inter, sans-serif",
  "headerFontWeight": "600",
  "headerHeightMode": "fixed",
  "headerHeight": 44,

  "rowBackgroundColor": "#FFFFFF",
  "rowAlternateColor": "#F9FAFB",
  "rowHoverColor": "#F3F4F6",
  "rowVerticalPaddingScale": 1,

  "cellColor": "#111827",
  "cellFontFamily": "Inter, sans-serif",
  "cellFontSize": "14px",
  "cellSelectionBorderColor": "#6366F1",

  "selectedRowBackgroundColor": "#EEF2FF",
  "selectionCheckboxColor": "#6366F1",
