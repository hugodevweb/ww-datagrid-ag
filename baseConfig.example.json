  "focusShadow": "0 0 0 3px rgba(99, 102, 241, 0.2)",
  "userFocusColor": "#6366F1",

  "menuBackgroundColor": "#FFFFFF",
  "menuTextColor": "#111827",
  "columnHoverColor": "#F3F4F6",

  "columnChooserBackground": "#FFFFFF",
  "columnChooserBorderColor": "#E5E7EB",
  "columnChooserBorderRadius": "8px",
  "columnChooserTextColor": "#111827",
  "columnChooserAccentColor": "#6366F1",
  "columnChooserWidth": "260px",

  "actionBackgroundColor": "transparent",
  "actionColor": "#6366F1",
  "actionPadding": "4px 8px",
  "actionBorder": "1px solid #6366F1",
  "actionBorderRadius": "4px",
  "actionFontSize": "13px",
  "actionFontFamily": "Inter, sans-serif",
  "actionFontWeight": "500",
  "actionFontStyle": "normal",
  "actionLineHeight": "1.5"
